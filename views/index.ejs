<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">

<head>
  <script src="./js/color-modes.js"></script>
  <link rel="stylesheet" href="./bootstrap-icons-1.10.5/font/bootstrap-icons.min.css" />
  <link rel="shortcut icon" href="./img/omar-circle.png" type="image/x-icon">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="" />
  <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors" />
  <meta name="generator" content="Hugo 0.112.5" />
  <title>Home page</title>

  <link href="./css/bootstrap.min.css" rel="stylesheet" />

  <link rel="stylesheet" href="./css/dark-light.css">

  <!-- Custom styles for this template -->
  <link href="./css/sidebars.css" rel="stylesheet" />
  <link rel="stylesheet" href="./css/myStyle.css" />
  <script src="https://cdn.lordicon.com/lordicon.js"></script>
</head>

<body>
<%- include("./Components/loading.ejs") %> 

  <main class="d-flex flex-nowrap">
    <%- include('./Components/sidebar.ejs', {currentPage: "index"}) %>

    <section class="w-100">
      <%- include('./Components/navbar.ejs') %>

      <!-- Page Top Header with Add Customer button -->
      <div class="d-flex flex-wrap justify-content-between align-items-center px-4 pt-4 pb-2 gap-2">
        <div>
          <h1 class="h3 fw-bold mb-1">Customers</h1>
          <p class="text-secondary small mb-0">Manage customer records, actions, and details</p>
        </div>
        <a href="/user/add" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm text-decoration-none">
          <span class="material-symbols-outlined" style="font-size: 20px;">add</span>
          <span class="fw-medium">Add Customer</span>
        </a>
      </div>

      <% if (arr.length > 0) { %>
      <div class="table-responsive-custom px-3">
        <table style="width: 100%" class="text-center mx-auto table mt-3 table-striped table-bordered">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Full Name</th>
              <th scope="col">Gender</th>
              <th scope="col">Country</th>
              <th scope="col">Age</th>
              <th scope="col">Last updated</th>
              <th scope="col">Action</th>
            </tr>
          </thead>
          
          <% arr.forEach((item, index) => { %>
          <tr>
            <th scope="row"><%= index + 1 %></th>
            <td><%= item.fireName %> <%= item.lastName %></td>
            <td><%= item.gender %></td>
            <td><%= item.country %></td>
            <td><%= item.age %></td>
            <td><%= moment(item.updatedAt).fromNow() %> </td>
            <td>
              <div class="d-inline-flex gap-1 align-items-center">
                <a class="btn btn-primary btn-sm d-inline-flex align-items-center justify-content-center" href="/view/<%= item._id %>" title="View" style="width: 32px; height: 32px; padding: 0;">
                  <lord-icon src="https://cdn.lordicon.com/vfczflna.json" trigger="hover" colors="primary:#ffffff,secondary:#ffffff"
                    style="width:20px;height:20px">
                  </lord-icon>
                </a>

                <a class="btn btn-primary btn-sm d-inline-flex align-items-center justify-content-center" href="/edit/<%= item._id %>" title="Edit" style="width: 32px; height: 32px; padding: 0;">
                  <lord-icon src="https://cdn.lordicon.com/wuvorxbv.json" trigger="hover" colors="primary:#ffffff,secondary:#ffffff"
                    style="width:20px;height:20px">
                  </lord-icon>
                </a>

                <form action="/edit/<%= item._id %>?_method=DELETE" method="post" class="d-inline m-0">
                  <button class="btn btn-danger btn-sm d-inline-flex align-items-center justify-content-center" title="Delete" style="width: 32px; height: 32px; padding: 0;">
                    <lord-icon src="https://cdn.lordicon.com/jmkrnisz.json" trigger="hover" colors="primary:#ffffff,secondary:#ffffff"
                      style="width:20px;height:20px">
                    </lord-icon>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </table>
      </div>
      <% } else { %>
        <div class="alert alert-info text-center w-50 mx-auto mt-5" role="alert">
          <img src="./img/undraw_looking-for-answers_5p23.svg" alt="" width="15%" height="15%">
          <br>
          No data available
          <br>
          <a class="btn btn-primary mt-2 rounded-pill px-4" href="./user/add">Add Customers</a>
        </div>
      <% } %>
    </section>
  </main>
  <script src="./js/bootstrap.bundle.min.js"></script>
  <script src="./js/sidebars.js"></script>
  <script src="./js/main.js"></script>
</body>

</html>