<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">

<head>
  <script src="./js/color-modes.js"></script>
  <link rel="stylesheet" href="./bootstrap-icons-1.10.5/font/bootstrap-icons.min.css" />
  <link rel="shortcut icon" href="./img/omar-circle.png" type="image/x-icon">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <meta name="description" content="Customer Management System" />
  <title>Home - Customers</title>

  <link href="./css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="./css/dark-light.css">
  <link href="./css/sidebars.css" rel="stylesheet" />
  <link rel="stylesheet" href="./css/myStyle.css" />
  <script src="https://cdn.lordicon.com/lordicon.js"></script>
</head>

<body>
  <%- include("./Components/loading.ejs") %> 

  <main class="main-layout">
    <%- include('./Components/sidebar.ejs', {currentPage: "index"}) %>

    <section class="content-section">
      <%- include('./Components/navbar.ejs') %>

      <div class="page-container">
        <!-- Page Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
          <div>
            <h1 class="h3 fw-bold mb-1">Customers</h1>
            <p class="text-secondary small mb-0">Manage customer records, actions, and details</p>
          </div>
          <a href="/user/add" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm">
            <span class="material-symbols-outlined" style="font-size: 20px;">add</span>
            <span class="fw-medium">Add Customer</span>
          </a>
        </div>

        <% if (arr && arr.length > 0) { %>
        <div class="card-box p-0 overflow-hidden">
          <div class="table-responsive-custom border-0">
            <table class="table table-hover align-middle text-center m-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="py-3">#</th>
                  <th scope="col" class="py-3 text-start ps-4">Full Name</th>
                  <th scope="col" class="py-3">Gender</th>
                  <th scope="col" class="py-3">Country</th>
                  <th scope="col" class="py-3">Age</th>
                  <th scope="col" class="py-3">Last Updated</th>
                  <th scope="col" class="py-3 text-center">Action</th>
                </tr>
              </thead>
              <tbody>
                <% arr.forEach((item, index) => { %>
                <tr>
                  <th scope="row" class="text-muted"><%= index + 1 %></th>
                  <td class="text-start ps-4">
                    <span class="fw-semibold"><%= item.fireName %> <%= item.lastName %></span>
                    <% if (item.email) { %>
                      <div class="small text-muted"><%= item.email %></div>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge <%= item.gender === 'Male' ? 'bg-primary-subtle text-primary' : 'bg-danger-subtle text-danger' %> px-2 py-1 rounded-pill">
                      <%= item.gender %>
                    </span>
                  </td>
                  <td><%= item.country || 'N/A' %></td>
                  <td><%= item.age || '-' %></td>
                  <td class="text-muted small"><%= moment(item.updatedAt).fromNow() %></td>
                  <td>
                    <div class="d-inline-flex gap-2 align-items-center justify-content-center">
                      <a class="btn btn-sm btn-outline-primary rounded-circle d-inline-flex align-items-center justify-content-center" href="/view/<%= item._id %>" title="View Details" style="width: 34px; height: 34px; padding: 0;">
                        <lord-icon src="https://cdn.lordicon.com/vfczflna.json" trigger="hover" colors="primary:currentColor,secondary:currentColor" style="width:18px;height:18px"></lord-icon>
                      </a>

                      <a class="btn btn-sm btn-outline-warning rounded-circle d-inline-flex align-items-center justify-content-center" href="/edit/<%= item._id %>" title="Edit Customer" style="width: 34px; height: 34px; padding: 0;">
                        <lord-icon src="https://cdn.lordicon.com/wuvorxbv.json" trigger="hover" colors="primary:currentColor,secondary:currentColor" style="width:18px;height:18px"></lord-icon>
                      </a>

                      <button type="button" class="btn btn-sm btn-outline-danger rounded-circle d-inline-flex align-items-center justify-content-center" data-bs-toggle="modal" data-bs-target="#deleteModal<%= item._id %>" title="Delete" style="width: 34px; height: 34px; padding: 0;">
                        <lord-icon src="https://cdn.lordicon.com/jmkrnisz.json" trigger="hover" colors="primary:currentColor,secondary:currentColor" style="width:18px;height:18px"></lord-icon>
                      </button>

                      <!-- Modal for Delete Confirmation -->
                      <div class="modal fade" id="deleteModal<%= item._id %>" tabindex="-1" aria-labelledby="deleteLabel<%= item._id %>" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content">
                            <div class="modal-header">
                              <h5 class="modal-title" id="deleteLabel<%= item._id %>">Confirm Delete</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-start">
                              Are you sure you want to delete customer <strong><%= item.fireName %> <%= item.lastName %></strong>?
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                              <form action="/edit/<%= item._id %>?_method=DELETE" method="post" class="d-inline m-0">
                                <button type="submit" class="btn btn-danger">Delete</button>
                              </form>
                            </div>
                          </div>
                        </div>
                      </div>

                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <% } else { %>
        <div class="card-box text-center py-5">
          <img src="./img/undraw_looking-for-answers_5p23.svg" alt="No Data" style="width: 140px; max-width: 100%; height: auto; margin-bottom: 1.25rem;">
          <h4 class="fw-bold mb-2">No customers found</h4>
          <p class="text-secondary mb-4">Start by adding your first customer to the system.</p>
          <a class="btn btn-primary px-4 py-2 rounded-pill" href="/user/add">Add Customer</a>
        </div>
        <% } %>
      </div>
    </section>
  </main>

  <script src="./js/bootstrap.bundle.min.js"></script>
  <script src="./js/sidebars.js"></script>
  <script src="./js/main.js"></script>
</body>

</html>