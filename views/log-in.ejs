<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Login - Customer App</title>
    <link rel="shortcut icon" href="/img/omar-circle.png" type="image/x-icon">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <form class="form" method="post" action="/login" id="login-form">

          <p class="form-title">Log in</p>

          <div class="input-container">
            <input type="text" placeholder="Enter username" name="userName" required minlength="3" autocomplete="username">
          </div>
          <div class="input-container">
            <input type="password" placeholder="Enter password" name="password" required minlength="8" autocomplete="current-password">
          </div>
          <button type="submit" class="submit" id="submit">
            Log In
          </button>

          <p class="signup-link">
            Don't have an account?
            <a href="/signup">Sign up</a>
          </p>
       </form>
    </div>
    <script>
      const form = document.getElementById("login-form");
      const button = document.getElementById("submit");
      if (form && button) {
        form.addEventListener("submit", (e) => {
          button.innerHTML = "Logging in...";
          button.disabled = true;
        });
      }
    </script>
</body>
</html>