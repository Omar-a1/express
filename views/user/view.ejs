<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
  <head>
    <script src="../js/color-modes.js"></script>
    <link
      rel="stylesheet"
      href="../bootstrap-icons-1.10.5/font/bootstrap-icons.min.css"
    />
    <link rel="shortcut icon" href="../img/omar-circle.png" type="image/x-icon">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="View Customer" />
    <title>Customer Profile - <%= user.fireName %> <%= user.lastName %></title>

    <link href="../css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="../css/dark-light.css">
    <link href="../css/sidebars.css" rel="stylesheet" />
    <link rel="stylesheet" href="../css/myStyle.css" />
    <script src="https://cdn.lordicon.com/lordicon.js"></script>
  </head>
  <body>
    <%- include("../Components/loading.ejs") %> 
    <%- include('../Components/dark-light.ejs') %>

    <main class="main-layout">
      <%- include('../Components/sidebar.ejs', {currentPage: "view"}) %>

      <section class="content-section">
        <%- include('../Components/navbar.ejs') %>

        <div class="page-container">
          <!-- Breadcrumb & Header info -->
          <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/home" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= user.fireName %> <%= user.lastName %></li>
              </ol>
            </nav>
            <div class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill font-monospace small">
              ID: <%= user._id %>
            </div>
          </div>

          <div class="card-box">
            <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-4 gap-2">
              <div>
                <h2 class="h4 fw-bold mb-1"><%= user.fireName %> <%= user.lastName %></h2>
                <span class="badge <%= user.gender === 'Male' ? 'bg-primary-subtle text-primary' : 'bg-danger-subtle text-danger' %> px-2.5 py-1 rounded-pill">
                  <%= user.gender %>
                </span>
              </div>
              <div class="d-flex gap-2">
                <a href="/edit/<%= user._id %>" class="btn btn-outline-primary px-3 py-2 rounded-pill d-inline-flex align-items-center gap-1">
                  <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                  <span>Edit</span>
                </a>
                <a href="/home" class="btn btn-secondary px-3 py-2 rounded-pill">Back to list</a>
              </div>
            </div>

            <div class="table-responsive-custom">
              <table class="table table-hover align-middle mb-0">
                <tbody>
                  <tr>
                    <th scope="row" style="width: 25%;" class="text-muted fw-semibold">First Name</th>
                    <td class="fw-medium"><%= user.fireName %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="text-muted fw-semibold">Last Name</th>
                    <td class="fw-medium"><%= user.lastName %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="text-muted fw-semibold">Telephone</th>
                    <td><a href="tel:<%= user.phoneNumber %>" class="text-decoration-none"><%= user.phoneNumber %></a></td>
                  </tr>
                  <tr>
                    <th scope="row" class="text-muted fw-semibold">Email</th>
                    <td><a href="mailto:<%= user.email %>" class="text-decoration-none"><%= user.email %></a></td>
                  </tr>
                  <tr>
                    <th scope="row" class="text-muted fw-semibold">Gender</th>
                    <td><%= user.gender %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="text-muted fw-semibold">Age</th>
                    <td><%= user.age %> years old</td>
                  </tr>
                  <tr>
                    <th scope="row" class="text-muted fw-semibold">Country</th>
                    <td><%= user.country %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="text-muted fw-semibold">Registered Date</th>
                    <td class="text-muted"><%= moment(user.createdAt).format("YYYY-MM-DD - hh:mm A") %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="text-muted fw-semibold">Last Updated</th>
                    <td class="text-muted"><%= moment(user.updatedAt).fromNow() %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script src="../js/bootstrap.bundle.min.js"></script>
    <script src="../js/sidebars.js"></script>
    <script src="../js/main.js"></script>
  </body>
</html>
